hl(0, "Float", { link = "Number" })

hl(0, "Operator", { fg = colors.accent3 })
hl(0, "Special", { fg = colors.accent3 })

hl(0, "PreProc", { fg = colors.accent1 })
hl(0, "Include", { link = "PreProc" })
hl(0, "Macro", { link = "PreProc" })
hl(0, "PreCondit", { link = "PreProc" })

hl(0, "Type", { fg = colors.accent2 })
hl(0, "StorageClass", { fg = c_mixed_type })
hl(0, "Structure", { link = "Type" })
hl(0, "Typedef", { link = "Type" })

