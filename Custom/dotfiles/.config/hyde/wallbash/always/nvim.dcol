${XDG_CONFIG_HOME:-$HOME/.config}/nvim/colors/wallbash.lua
-- Auto-generated by Wallbash for Neovim (LazyVim compatible)

vim.cmd("hi clear")
if vim.fn.exists("syntax_on") then
  vim.cmd("syntax reset")
end
vim.o.termguicolors = true
vim.g.colors_name = "wallbash"

local colors = {
  bg = "#<wallbash_pry1>",
  fg = "#<wallbash_txt1>",
  bg2 = "#<wallbash_pry2>",
  fg2 = "#<wallbash_txt2>",
  bg3 = "#<wallbash_pry3>",
  fg3 = "#<wallbash_txt3>",
  accent1 = "#<wallbash_1xa8>",
  accent2 = "#<wallbash_2xa8>",
  accent3 = "#<wallbash_3xa8>",
  accent4 = "#<wallbash_4xa8>",
  error = "#<wallbash_1xa8>",
  warn = "#<wallbash_3xa8>",
  info = "#<wallbash_2xa8>",
  hint = "#<wallbash_4xa8>",
}

-- Color blending utility to force high contrast between syntax elements
local function hex2rgb(hex)
  return tonumber(hex:sub(2, 3), 16), tonumber(hex:sub(4, 5), 16), tonumber(hex:sub(6, 7), 16)
end
local function rgb2hex(r, g, b)
  return string.format("#%02x%02x%02x", r, g, b)
end
local function blend(hex1, hex2, alpha)
  local r1, g1, b1 = hex2rgb(hex1)
  local r2, g2, b2 = hex2rgb(hex2)
  local r = math.min(255, math.max(0, math.floor(r1 * alpha + r2 * (1 - alpha))))
  local g = math.min(255, math.max(0, math.floor(g1 * alpha + g2 * (1 - alpha))))
  local b = math.min(255, math.max(0, math.floor(b1 * alpha + b2 * (1 - alpha))))
  return rgb2hex(r, g, b)
end

-- Generate blended derivative colors strictly for unassigned/edge-case syntax elements
local c_mixed_type = blend(colors.accent2, colors.accent3, 0.6) -- Purple/Yellow mix for StorageClass/builtins
local c_mixed_var  = blend(colors.accent3, colors.accent2, 0.5) -- Mixed accent for parameters
local c_cursorline = blend(colors.bg2, colors.bg, 0.25)         -- Highly muted background for cursor line
local c_selection  = blend(colors.bg3, colors.bg, 0.35)         -- Muted background for visual/menu selections

local hl = vim.api.nvim_set_hl

-- Base highlights
hl(0, "Normal", { bg = "NONE", fg = colors.fg })
hl(0, "NormalFloat", { bg = "NONE", fg = colors.fg2 })
hl(0, "NormalNC", { bg = "NONE", fg = colors.fg })
hl(0, "FloatBorder", { bg = "NONE", fg = colors.bg3 })
hl(0, "FloatTitle", { bg = "NONE", fg = colors.accent1 })
hl(0, "Comment", { fg = colors.bg3, italic = true })
hl(0, "Keyword", { fg = colors.accent1, bold = true })
hl(0, "Function", { fg = colors.accent3, bold = true })
hl(0, "String", { fg = colors.accent4 })
hl(0, "Number", { fg = colors.accent4 })
hl(0, "Type", { fg = colors.accent2 })
hl(0, "Identifier", { fg = colors.fg })
hl(0, "Statement", { fg = colors.accent1 })
hl(0, "Conditional", { link = "Statement" })
hl(0, "Repeat", { link = "Statement" })
hl(0, "Label", { link = "Statement" })
hl(0, "Exception", { link = "Statement" })

hl(0, "Constant", { fg = colors.accent4 })
